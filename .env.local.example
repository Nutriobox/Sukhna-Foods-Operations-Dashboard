# Copy this file to ".env.local" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
# The anon key is safe to expose in the browser (protected by Row Level Security).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# The buyer this dashboard reconciles against (used by validation Check 2).
NEXT_PUBLIC_BUYER_GST=09AANCA9064A1ZL
NEXT_PUBLIC_BUYER_NAME=Allsure Services Pvt Ltd

# Optional: shared secret the email→extraction webhook must send to /api/ingest.
INGEST_SECRET=change-me-to-a-long-random-string

# ── Live PACT inventory sync (Sales Order tile) ──────────────────────────────
# The dashboard "Sync now from PACT" button dispatches a GitHub Actions run
# (.github/workflows/sync-inventory.yml → scripts/sync-inventory.js). These go on
# the SERVER (Vercel env) and in GitHub → Settings → Secrets and variables → Actions.
#
# Server (Vercel) — needed for the "Sync now" button:
#   GH_DISPATCH_TOKEN=github_pat_...     # PAT with repo/actions dispatch scope
#   GH_REPO=owner/Sukhna-Foods-Operations-Dashboard
#
# GitHub Actions secrets — needed by the sync job:
#   PACT_USER, PACT_PASS, PACT_URL       # (same PACT login the Stock Inward job uses)
#   SUPABASE_URL, SUPABASE_SERVICE_KEY   # service key writes the inventory snapshot
#   (The report request template is baked into scripts/sync-inventory.js — re-run
#    record-inventory.bat and re-capture only if PACT changes that report.)
