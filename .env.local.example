# Copy this file to ".env.local" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
# The anon key is safe to expose in the browser (protected by Row Level Security).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# The buyer this dashboard reconciles against (used by validation Check 2).
NEXT_PUBLIC_BUYER_GST=09AANCA9064A1ZL
NEXT_PUBLIC_BUYER_NAME=Allsure Services Pvt Ltd

# Optional: shared secret the email→extraction webhook must send to /api/ingest.
INGEST_SECRET=change-me-to-a-long-random-string
