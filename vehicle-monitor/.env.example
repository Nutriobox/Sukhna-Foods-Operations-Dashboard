# Copy to ".env" and fill in real values. Never commit .env.
# OneLap login is your phone number + password.
TRACKER_USER=8130864187
TRACKER_PASSWORD=your-onelap-password

# Google Cloud > enable "Geocoding API" > create API key.
GOOGLE_MAPS_API_KEY=your-google-key

# Supabase project settings > API.
SUPABASE_URL=https://YOUR-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# false = watch the browser work; true = invisible (for the server later).
HEADLESS=false
